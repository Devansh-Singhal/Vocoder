{
  "name": "default",
  "description": "Live vocal control for Antares Harmony Engine via one hand. Labels name real Harmony Engine controls; see README for the MIDI-learn order.",
  "settings": {
    "midi_port_name": "loopMIDI Port",
    "midi_channel": 1,
    "min_send_interval_ms": 8
  },
  "mappings": [
    {
      "_target": "Voice 1-4 Gain -- learn this one CC onto all four faders",
      "label": "Voice Gain",
      "gesture": "hand_height",
      "cc": 20,
      "min": 0, "max": 127,
      "invert": false,
      "smoothing": 0.65,
      "deadzone": 0.006,
      "mode": "continuous",
      "enabled": true
    },
    {
      "_target": "Voice 1-4 Throat Length. Very sensitive: narrow min/max once learned",
      "label": "Throat Length",
      "gesture": "hand_x",
      "cc": 21,
      "min": 40, "max": 90,
      "invert": false,
      "smoothing": 0.7,
      "deadzone": 0.008,
      "mode": "continuous",
      "enabled": true
    },
    {
      "_target": "Spread, in the Harmony Control panel",
      "label": "Spread",
      "gesture": "palm_rotation",
      "cc": 22,
      "min": 0, "max": 127,
      "invert": false,
      "smoothing": 0.75,
      "deadzone": 0.01,
      "mode": "continuous",
      "enabled": true
    },
    {
      "_target": "Glide -> Transition Rate",
      "label": "Glide Rate",
      "gesture": "pinch_amount",
      "cc": 23,
      "min": 0, "max": 127,
      "invert": false,
      "smoothing": 0.6,
      "deadzone": 0.008,
      "mode": "continuous",
      "enabled": true
    },
    {
      "_target": "Choir Size",
      "label": "Choir Size",
      "gesture": "finger_count",
      "cc": 24,
      "min": 0, "max": 127,
      "invert": false,
      "smoothing": 0.0,
      "deadzone": 0.05,
      "mode": "steps",
      "steps": 6,
      "enabled": true
    },
    {
      "_target": "Choir Bypass. Inverted, so an open hand brings the choir IN",
      "label": "Choir On",
      "gesture": "open_hand",
      "cc": 25,
      "min": 0, "max": 127,
      "invert": true,
      "smoothing": 0.0,
      "deadzone": 0.0,
      "mode": "toggle",
      "enabled": true
    },
    {
      "_target": "Reaper's own FX Bypass for Harmony Engine -- the kill switch",
      "label": "Bypass",
      "gesture": "closed_fist",
      "cc": 26,
      "min": 0, "max": 127,
      "invert": false,
      "smoothing": 0.0,
      "deadzone": 0.0,
      "mode": "toggle",
      "enabled": true
    },
    {
      "_target": "Choir -> Vibrato. Fingers together vs splayed.",
      "label": "Choir Vibrato",
      "gesture": "finger_spread",
      "cc": 27,
      "min": 0, "max": 127,
      "invert": false,
      "smoothing": 0.7,
      "deadzone": 0.008,
      "mode": "continuous",
      "enabled": true
    },
    {
      "_target": "Humanize -> Pitch Variation. Push hand toward camera / pull away.",
      "label": "Humanize Pitch",
      "gesture": "hand_distance",
      "cc": 28,
      "min": 0, "max": 127,
      "invert": false,
      "smoothing": 0.7,
      "deadzone": 0.008,
      "mode": "continuous",
      "enabled": true
    }
  ]
}
